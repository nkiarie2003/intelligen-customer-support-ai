SECRET_KEY=replace-with-a-long-random-secret
# Flask-SQLAlchemy resolves this file inside Flask's instance folder.
DATABASE_URL=sqlite:///customer_intelligence.db
API_DEMO_KEY=replace-this-demo-api-key
TRAINING_DATA=data/processed/cfpb_complaints.csv
CONVERSATION_DATA=data/processed/twitter_support_pairs.csv

# Live Flask inference is local in the SHU-compatible architecture.
INFERENCE_MODE=local

# Set these on the Azure ML compute instance before cloud training.
TRAINING_PLATFORM=local
AZURE_ML_SUBSCRIPTION=8fc122ca-79a2-4628-9c9a-69278b28526d
AZURE_ML_RESOURCE_GROUP=dtl-2526-55-710266-bf-AITraining-890311
AZURE_ML_WORKSPACE=mlworkspace-traning
AZURE_ML_COMPUTE=c50411741-ML

# Advanced AI features. Install requirements-advanced.txt, then enable selectively.
ENABLE_ZERO_SHOT=false
ENABLE_TRANSFORMER_SENTIMENT=false
ENABLE_EMBEDDINGS=false
ENABLE_LOCAL_GENERATOR=false
ENABLE_CONVERSATION_EXAMPLES=true

ZERO_SHOT_MODEL=facebook/bart-large-mnli
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATOR_MODEL=google/flan-t5-small

# Privacy / governance
DATA_RETENTION_DAYS=90
SESSION_COOKIE_SECURE=false
